{
  "name": "equiblesagent",
  "title": "Equibles Agent Terminal",
  "description": "A paid remote MCP for Equibles, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://equiblesagent.clauxel.com/",
  "documentationUrl": "https://equiblesagent.clauxel.com/mcp/",
  "endpointUrl": "https://equiblesagent.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://equiblesagent.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://equiblesagent.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://equiblesagent.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "analyst",
        "name": "Analyst",
        "monthlyUsd": 49
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 149
      },
      {
        "id": "desk",
        "name": "Desk",
        "monthlyUsd": 499
      }
    ]
  },
